super + {equal,minus,m} 
	$HOME/sucklessToolsConfig/scripts/volume.sh {up,down,toggle}
super + p
	$HOME/sucklessToolsConfig/scripts/pipe_clipboard/pipe_clipboard
super + s
	$HOME/sucklessToolsConfig/scripts/takescreenshot.sh
super + a
	$HOME/sucklessToolsConfig/scripts/mount-android-device.sh
super + n
	$HOME/sucklessToolsConfig/scripts/bluetoothconnect.sh
super + shift + n
	$HOME/sucklessToolsConfig/scripts/bluetoothdisconnect.sh
super + x 
	xscreensaver-command -lock
super + z
	$HOME/sucklessToolsConfig/scripts/display.sh extend
super + shift + z
	$HOME/sucklessToolsConfig/scripts/display.sh main
